{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cobusgreyling/grok-bot-templates/schema/skill.schema.json",
  "title": "Grok Bot Skill",
  "description": "The six fields xAI documents for a useful skill: when, inputs, sequence, validate, return, approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "when_to_use",
    "inputs",
    "sequence",
    "validate",
    "returns",
    "approval"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 4, "maxLength": 80 },
    "when_to_use": { "type": "string", "minLength": 24 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sequence": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "validate": { "type": "string", "minLength": 24 },
    "returns": { "type": "string", "minLength": 24 },
    "approval": { "type": "string", "minLength": 24 },
    "owners": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
